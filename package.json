{
  "author": "Farhollow",
  "build": {
    "appId": "com.farhollow.lawfirm.launcher",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "assets/dgm-icon.ico",
      "assets/dgm-logo.png",
      "assets/tray.png",
      "package.json"
    ],
    "nsis": {
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "oneClick": false,
      "shortcutName": "Law Firm Launcher"
    },
    "productName": "Law Firm Launcher",
    "win": {
      "icon": "assets/dgm-icon.ico",
      "target": [
        {
          "arch": [
            "x64"
          ],
          "target": "nsis"
        }
      ]
    }
  },
  "description": "Desktop launcher for the Law Firm Case Management server",
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "license": "UNLICENSED",
  "main": "main.js",
  "name": "law-firm-launcher",
  "private": true,
  "productName": "Law Firm Launcher",
  "scripts": {
    "dist": "electron-builder --win --publish never",
    "start": "electron ."
  },
  "version": "1.0.1"
}